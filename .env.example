# Mapbox public access token — required for the globe, location search and
# reverse geocoding. Create one at https://account.mapbox.com/access-tokens/
# Without it the app still runs: Places, adding, editing and deleting all work,
# and the globe shows a polished explanation instead of crashing.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Set to "false" to start with an empty travel history instead of the
# fourteen sample places. Any other value (or omitting it) seeds them once,
# on first run only.
NEXT_PUBLIC_SEED_SAMPLE_DATA=true
