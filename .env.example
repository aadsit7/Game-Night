# The map needs no API key. Tiles come from OpenFreeMap and place search from
# Photon, both keyless and open. There is nothing to paste in here to make the
# globe work — copy this file only if you want to change one of the settings
# below.

# Set to "false" to start with an empty travel history instead of the
# fourteen sample places. Any other value (or omitting it) seeds them once,
# on first run only.
NEXT_PUBLIC_SEED_SAMPLE_DATA=true

# Where cross-device sync stores the collection. Defaults to this repository;
# override only if you keep your travel data somewhere else. The write token is
# never set here — it is pasted per-device in the app's Sync screen, because a
# token compiled into a static site is readable by every visitor.
# NEXT_PUBLIC_SYNC_OWNER=aadsit7
# NEXT_PUBLIC_SYNC_REPO=Game-Night
# NEXT_PUBLIC_SYNC_BRANCH=main
# NEXT_PUBLIC_SYNC_PATH=data/places.json
